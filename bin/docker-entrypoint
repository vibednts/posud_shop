#!/bin/bash -e

# Перед запуском веб-сервера створюємо БД або застосовуємо нові міграції.
# Команду може бути передано окремими аргументами (./bin/rails server)
# або одним рядком через sh -c (так робить Render), тому шукаємо
# "rails server" у всьому рядку команди.
if [[ "$*" == *"rails server"* || "$*" == *"thrust"* ]]; then
  ./bin/rails db:prepare
fi

exec "${@}"
