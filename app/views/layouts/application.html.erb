<!DOCTYPE html>
<html lang="uk">
  <head>
    <title><%= content_for(:title) || "DishShop — посудомийні машини" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Onest:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  </head>

  <body>
    <header class="site-header">
      <div class="container header-inner">
        <%= link_to root_path, class: "logo" do %>
          <span class="logo-mark"></span>Dish<b>Shop</b>
        <% end %>

        <input type="checkbox" id="nav-toggle" class="nav-toggle">
        <label for="nav-toggle" class="nav-burger" aria-label="Меню"><span></span></label>

        <nav class="nav">
          <%= link_to "Головна", root_path, class: "nav-link" %>
	<%= link_to "Каталог", products_path, class: "nav-link" %>
  <%= link_to "Доставка й оплата", delivery_path, class: "nav-link" %>
    <%= link_to "Гарантія", warranty_path, class: "nav-link" %>

	<%= link_to "Контакти", contacts_path, class: "nav-link" %>
        </nav>

       <div class="header-actions">
       <%= link_to cart_path, class: "btn btn-outline cart-link" do %>
  Кошик <span class="cart-badge"><%= cart_count %></span>
<% end %>
<%= link_to "Замовлення", orders_path, class: "btn btn-ghost" %>
  <% if user_signed_in? %>
  <%= link_to "Адмін", admin_root_path, class: "btn btn-ghost" if current_user.admin? %>
    <%= link_to (current_user.name.presence || current_user.email), edit_user_registration_path, class: "btn btn-ghost" %>
    <%= button_to "Вийти", destroy_user_session_path, method: :delete, class: "btn btn-ghost", form_class: "inline-form" %>
  <% else %>
    <%= link_to "Увійти", new_user_session_path, class: "btn btn-ghost" %>
    <%= link_to "Реєстрація", new_user_registration_path, class: "btn btn-primary" %>
  <% end %>
</div>
      </div>
    </header>

    <% if notice %><div class="flash flash-ok container"><%= notice %></div><% end %>
    <% if alert %><div class="flash flash-err container"><%= alert %></div><% end %>
<%= render "admin/shared/nav" if controller_path.start_with?("admin/") %>
    <main><%= yield %></main>

   <footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <div class="logo logo-light"><span class="logo-mark"></span>Dish<b>Shop</b></div>
      <p class="muted">Посудомийні машини провідних брендів із гарантією та доставкою по Україні.</p>
    </div>
    <div>
      <h4>Магазин</h4>
      <%= link_to "Каталог", products_path %>
      <%= link_to "Вбудовані", products_path(installation: "built_in") %>
      <%= link_to "Окремостоячі", products_path(installation: "freestanding") %>
      <%= link_to "Аксесуари", products_path(category: "accessory") %>
      <%= link_to "Як обрати машину", guide_path %>
    </div>
    <div>
      <h4>Клієнтам</h4>
      <%= link_to "Доставка й оплата", delivery_path %>
      <%= link_to "Гарантія", warranty_path %>
      <%= link_to "Зворотний зв'язок", contacts_path %>
    </div>
    <div>
      <h4>Контакти</h4>
      <span>Пн-Нд, 9:00-20:00</span>
      <a href="tel:+380662539501">+380 66 253 95 01</a>
      <a href="mailto:info@dishshop.ua">info@dishshop.ua</a>
    </div>
  </div>
  <div class="container footer-bottom">© <%= Time.current.year %> DishShop. Усі права захищено.</div>
</footer>
  </body>
</html>
