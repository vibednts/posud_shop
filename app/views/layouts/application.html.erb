<!DOCTYPE html>
<html lang="uk">
  <head>
    <title><%= content_for(:title) || "DishShop — посудомийні машини" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Onest:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  </head>

  <body>
    <header class="site-header">
      <div class="container header-inner">
        <%= link_to root_path, class: "logo" do %>
          <span class="logo-mark"></span>Dish<b>Shop</b>
        <% end %>

        <input type="checkbox" id="nav-toggle" class="nav-toggle">
        <label for="nav-toggle" class="nav-burger" aria-label="Меню"><span></span></label>

        <nav class="nav">
          <%= link_to "Головна", root_path, class: "nav-link" %>
          <a href="#" class="nav-link">Каталог</a>
          <a href="#" class="nav-link">Доставка й оплата</a>
          <a href="#" class="nav-link">Контакти</a>
        </nav>

        <div class="header-actions">
          <a href="#" class="btn btn-ghost">Увійти</a>
          <a href="#" class="btn btn-primary">Кошик</a>
        </div>
      </div>
    </header>

    <% if notice %><div class="flash flash-ok container"><%= notice %></div><% end %>
    <% if alert %><div class="flash flash-err container"><%= alert %></div><% end %>

    <main><%= yield %></main>

    <footer class="site-footer">
      <div class="container footer-grid">
        <div>
          <div class="logo logo-light"><span class="logo-mark"></span>Dish<b>Shop</b></div>
          <p class="muted">Посудомийні машини провідних брендів із гарантією та доставкою по Україні.</p>
        </div>
        <div>
          <h4>Магазин</h4>
          <a href="#">Каталог</a><a href="#">Вбудовані</a><a href="#">Окремостоячі</a><a href="#">Аксесуари</a>
        </div>
        <div>
          <h4>Клієнтам</h4>
          <a href="#">Доставка й оплата</a><a href="#">Гарантія</a><a href="#">Зворотний зв'язок</a>
        </div>
        <div>
          <h4>Контакти</h4>
          <span>Пн-Нд, 9:00-20:00</span><span>+380 00 000 00 00</span><span>info@dishshop.ua</span>
        </div>
      </div>
      <div class="container footer-bottom">© <%= Time.current.year %> DishShop. Усі права захищено.</div>
    </footer>
  </body>
</html>
