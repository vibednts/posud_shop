<div class="container auth">
  <div class="auth-card">
    <h1>Вхід</h1>
    <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
      <label class="field">Email
        <%= f.email_field :email, autofocus: true, autocomplete: "email" %>
      </label>
      <label class="field">Пароль
        <%= f.password_field :password, autocomplete: "current-password" %>
      </label>
      <label class="check"><%= f.check_box :remember_me %> Запам'ятати мене</label>
      <%= f.submit "Увійти", class: "btn btn-primary btn-block btn-lg" %>
    <% end %>
    <p class="auth-alt">Немає акаунта? <%= link_to "Зареєструватися", new_registration_path(resource_name) %></p>
  </div>
</div>
