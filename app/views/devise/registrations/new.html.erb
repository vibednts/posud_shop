<div class="container auth">
  <div class="auth-card">
    <h1>Реєстрація</h1>
    <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
      <% if resource.errors.any? %>
        <div class="flash flash-err">
          <ul class="err-list">
            <% resource.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %>
          </ul>
        </div>
      <% end %>

      <label class="field">Ім'я
        <%= f.text_field :name, autofocus: true, autocomplete: "name" %>
      </label>
      <label class="field">Телефон (необов'язково)
        <%= f.telephone_field :phone, placeholder: "+380...", autocomplete: "tel" %>
      </label>
      <label class="field">Email
        <%= f.email_field :email, autocomplete: "email" %>
      </label>
      <label class="field">Пароль
        <%= f.password_field :password, autocomplete: "new-password" %>
      </label>
      <label class="field">Підтвердіть пароль
        <%= f.password_field :password_confirmation, autocomplete: "new-password" %>
      </label>
      <%= f.submit "Створити акаунт", class: "btn btn-primary btn-block btn-lg" %>
    <% end %>
    <p class="auth-alt">Уже є акаунт? <%= link_to "Увійти", new_session_path(resource_name) %></p>
  </div>
</div>
