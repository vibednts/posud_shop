<div class="container page">
  <nav class="crumbs">
    <%= link_to "Головна", root_path %> / <%= link_to "Каталог", products_path %> /
    <%= link_to @product.category.name, products_path(category: @product.category.slug) %>
  </nav>

  <div class="product">
    <div class="product-media"><span><%= @product.brand %></span></div>

    <div>
      <h1><%= @product.name %></h1>
      <p class="stock <%= @product.in_stock? ? 'ok' : 'no' %>">
        <%= @product.in_stock? ? "В наявності: #{@product.stock} шт." : "Немає в наявності" %>
      </p>
      <div class="product-price"><%= format_price(@product.price) %></div>
      <%= button_to "Додати в кошик", cart_items_path, params: { product_id: @product.id },
              class: "btn btn-primary btn-lg", disabled: !@product.in_stock? %>
      <p class="product-desc"><%= @product.description %></p>
    </div>
  </div>

  <h2>Характеристики</h2>
  <table class="specs">
    <tr><th>Бренд</th><td><%= @product.brand %></td></tr>
    <tr><th>Ширина</th><td><%= @product.width_cm %> см</td></tr>
    <tr><th>Встановлення</th><td><%= @product.built_in? ? "Вбудована" : "Окремостояча" %></td></tr>
    <tr><th>Місткість</th><td><%= @product.capacity_sets %> комплектів</td></tr>
    <tr><th>Клас енергоефективності</th><td><%= @product.energy_class %></td></tr>
    <tr><th>Рівень шуму</th><td><%= @product.noise_db %> дБ</td></tr>
    <tr><th>Програм миття</th><td><%= @product.programs_count %></td></tr>
    <tr><th>Гарантія</th><td><%= @product.warranty_months %> міс.</td></tr>
  </table>
  
  <% reviews = @product.reviews.includes(:user).order(created_at: :desc) %>

<section id="reviews" class="reviews">
  <h2>
    Відгуки
    <% if reviews.any? %>
      <span class="rating-line">
        <span class="stars"><%= rating_stars(@product.average_rating) %></span>
        <%= @product.average_rating %> · <%= reviews.size %>
      </span>
    <% end %>
  </h2>

  <% if user_signed_in? %>
    <% if reviews.any? { |r| r.user_id == current_user.id } %>
      <p class="hint">Ви вже залишили відгук на цей товар.</p>
    <% else %>
      <%= form_with model: [@product, Review.new], class: "review-form panel" do |f| %>
        <h3>Ваш відгук</h3>
        <div class="star-input">
          <% 5.downto(1) do |n| %>
            <%= f.radio_button :rating, n, id: "star#{n}", required: true %>
            <label for="star<%= n %>" title="<%= n %>">★</label>
          <% end %>
        </div>
        <%= f.text_area :body, rows: 3, placeholder: "Поділіться враженнями про модель", required: true, minlength: 5 %>
        <%= f.submit "Надіслати відгук", class: "btn btn-primary" %>
      <% end %>
    <% end %>
  <% else %>
    <p class="hint"><%= link_to "Увійдіть", new_user_session_path %>, щоб залишити відгук.</p>
  <% end %>

  <% if reviews.empty? %>
    <div class="empty">Відгуків поки немає. Станьте першим!</div>
  <% else %>
    <div class="review-list">
      <% reviews.each do |review| %>
        <article class="review">
          <header>
            <b><%= review.user.name.presence || "Покупець" %></b>
            <span class="stars"><%= rating_stars(review.rating) %></span>
            <span class="muted-dark"><%= review.created_at.strftime("%d.%m.%Y") %></span>
            <% if user_signed_in? && (review.user_id == current_user.id || current_user.admin?) %>
              <%= button_to "Видалити", product_review_path(@product, review), method: :delete,
                            class: "link-danger", form_class: "inline-form",
                            data: { turbo_confirm: "Видалити відгук?" } %>
            <% end %>
          </header>
          <p><%= review.body %></p>
        </article>
      <% end %>
    </div>
  <% end %>
</section>
  
</div>
